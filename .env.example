# Local development only. Copy this file to .env.
# These values are intentionally non-sensitive and must never be reused in shared/production environments.

POSTGRES_PASSWORD=cashflow_local_only
CONSOLIDATION_POSTGRES_PASSWORD=consolidation_local_only
RABBITMQ_PASSWORD=cashflow_local_only

# Ready-to-run local Keycloak/client credentials.
# Replace them only when demonstrating outside your own machine.
KEYCLOAK_ADMIN_PASSWORD=cashflow_admin_local_only
DEMO_CLIENT_SECRET=cashflow_demo_local_only
READER_CLIENT_SECRET=cashflow_reader_local_only

# Optional overrides; Compose defaults are suitable for the documented local topology.
# CASHFLOW_AUTHORITY=http://identity:8080/realms/cashflow
# CASHFLOW_ISSUER=http://localhost:8080/realms/cashflow
# CASHFLOW_ALLOWED_CLIENT_IDS=cashflow-demo,cashflow-reader
